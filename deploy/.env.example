# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Домен, направленный на IP сервера (A-запись). Нужен для HTTPS — без него iPhone не подключится.
DOMAIN=api.example.ru

# Bundle id приложения — для проверки входа через Apple.
APPLE_BUNDLE_ID=com.garybail.recipeapp

# Когда обновлять цены (часы по Москве) и включено ли обновление.
PRICE_REFRESH_HOURS=7,12,18
PRICE_WATCH=1

# Магазины (через запятую): lenta, magnit, auchan, vkusvill, kuper. Лишний можно убрать, если он сбоит.
STORES=lenta,magnit,auchan,vkusvill,kuper
# Какую сеть показывать через Купер (как она называется в Купере): Лента, АШАН, Магнит, METRO, О'КЕЙ…
KUPER_RETAILER=Лента

# Почта для кодов подтверждения и восстановления пароля. Без неё коды пишутся в лог сервера.
# Для Яндекса: создайте «пароль приложения» в настройках Яндекс ID.
#SMTP_HOST=smtp.yandex.ru
#SMTP_PORT=465
#SMTP_USER=you@yandex.ru
#SMTP_PASSWORD=пароль_приложения
#SMTP_FROM=you@yandex.ru

# Push на iPhone (нужен платный Apple Developer аккаунт). Положите ключ .p8 в папку deploy/secrets.
#APNS_KEY_PATH=/secrets/AuthKey_XXXXXXXXXX.p8
#APNS_KEY_ID=XXXXXXXXXX
#APNS_TEAM_ID=YYYYYYYYYY
#APNS_SANDBOX=1

# Вход через VK ID и Яндекс ID. PUBLIC_URL — адрес этого сервера (https://api.example.ru).
# Яндекс: oauth.yandex.ru → создать приложение, Redirect URI: https://<домен>/auth/oauth/yandex/callback,
#   доступы «Доступ к адресу электронной почты» и «Доступ к логину, имени и фамилии».
# VK ID: id.vk.ru/business/go → создать приложение (Web), доверенный Redirect URL:
#   https://<домен>/auth/oauth/vk/callback, доступ к почте.
#PUBLIC_URL=https://api.example.ru
#YANDEX_CLIENT_ID=
#YANDEX_CLIENT_SECRET=
#VK_CLIENT_ID=
